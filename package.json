{
    "name": "dsh-vscode-bridge",
    "version": "0.1.0",
    "private": true,
    "description": "Open vscode:// links from the Harness Web UI in the local VS Code.",
    "type": "module",
    "main": "./index.js",
    "exports": {
        ".": "./index.js",
        "./client": "./lib/client.js",
        "./locale/*.json": "./locale/*.json",
        "./icon": "./icon.svg"
    },
    "files": [
        "index.js",
        "lib/**/*.js",
        "cordis.patch.yml",
        "locale/*.json",
        "icon.svg",
        "README.md"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": [
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-sidebar-right"
            ]
        }
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.10.1"
    }
}
